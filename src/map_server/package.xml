<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>map_server</name>
    <version>0.1.0</version>
    <description> 全局地图服务器：加载并发布静态地图（本期：nav2 标准 2D 栅格 map.yaml + map.pgm； 3D 点云留接口）。地图以“目录”为单位管理（与
        lightning 的 map_path 同一目录）， 支持运行时通过 LoadMap 服务切换站点。 </description>
    <maintainer email="gmd@todo.todo">gmd</maintainer>
    <license>LGPL-3.0</license>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <depend>rclcpp</depend>
    <depend>nav_msgs</depend>
    <depend>nav2_msgs</depend>
    <depend>sensor_msgs</depend>
    <depend>visualization_msgs</depend>
    <!-- 路网数据层（RouteGraph）：本节点负责加载/校验/可视化路网资产 -->
    <depend>pnc_2d</depend>

    <build_depend>yaml-cpp</build_depend>
    <exec_depend>yaml-cpp</exec_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>